        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json;\nconst metrics = response.metrics || {};\nconst state = response.lifecycle_state || {};\nconst serialized = JSON.stringify(state);\nconst result = {\n  success: Boolean(state?.plugin?.finalized) && Number(metrics.before_model_calls || 0) === 1 && Number(metrics.lifecycle_recovery_count || 0) >= 1 && serialized.includes('TOOL-908') && serialized.includes('Omega-42'),\n  finalized: Boolean(state?.plugin?.finalized),\n  before_model_calls: Number(metrics.before_model_calls || 0),\n  recovery_count: Number(metrics.lifecycle_recovery_count || 0),\n  lifecycle_event_count: Number(metrics.lifecycle_event_count || 0),\n  tool_fact_preserved: serialized.includes('TOOL-908'),\n  constraint_preserved: serialized.includes('Omega-42'),\n};\nreturn { json: result };"
      },
