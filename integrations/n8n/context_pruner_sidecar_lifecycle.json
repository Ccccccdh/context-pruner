        "jsCode": "const messages = [{ role: 'system', content: 'Hard constraint: preserve project Omega-42.' }];\nfor (let index = 0; index < 20; index += 1) {\n  const id = String(index).padStart(2, '0');\n  messages.push({ role: 'assistant', content: `Archived investigation ARCHIVE-${id}: obsolete branch evidence and superseded analysis. `.repeat(3) });\n  messages.push({ role: 'user', content: `Old request ${id}: inspect abandoned option ARCHIVE-${id}. `.repeat(3) });\n}\nmessages.push({ role: 'user', content: 'Current task: preserve Omega-42 and use fresh tool evidence only.' });\nreturn [{ json: {\n  source_session_id: 'n8n-lifecycle-source',\n  restored_session_id: 'n8n-lifecycle-restored',\n  messages,\n} }];"
